<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="392dp"
        android:layout_height="135dp"
        android:background="@drawable/card_item"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_class_session_title"
                android:layout_width="128dp"
                android:layout_height="26dp"
                android:layout_marginStart="44dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/aclonica"
                android:text="Class Title"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_class_time"
                android:layout_width="43dp"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:text="Time"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_class_dayofweek"
                app:layout_constraintTop_toTopOf="@+id/tv_class_dayofweek"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tv_class_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="116dp"
                android:text="Price: $0"
                android:textColor="@color/red"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.187"
                app:layout_constraintStart_toEndOf="@+id/tv_class_session_title"
                app:layout_constraintTop_toTopOf="@+id/tv_class_session_title" />

            <TextView
                android:id="@+id/tv_class_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="64dp"
                android:text="Capacity"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_class_duration" />

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="28dp"
                android:layout_height="19dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_class_session_title"
                app:srcCompat="@drawable/calendar" />

            <TextView
                android:id="@+id/tv_class_dayofweek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Days"
                app:layout_constraintStart_toEndOf="@+id/imageView14"
                app:layout_constraintTop_toTopOf="@+id/imageView14" />

            <ImageView
                android:id="@+id/imageView15"
                android:layout_width="26dp"
                android:layout_height="19dp"
                android:layout_marginStart="92dp"
                app:layout_constraintStart_toEndOf="@+id/tv_class_time"
                app:layout_constraintTop_toTopOf="@+id/tv_class_time"
                app:srcCompat="@drawable/category" />

            <TextView
                android:id="@+id/tv_class_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/imageView15"
                app:layout_constraintTop_toTopOf="@+id/imageView15" />

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="28dp"
                android:layout_height="22dp"
                android:layout_marginStart="36dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView14"
                app:layout_constraintVertical_bias="0.0"
                app:srcCompat="@drawable/duration" />

            <TextView
                android:id="@+id/tv_class_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Duration"
                app:layout_constraintStart_toEndOf="@+id/imageView16"
                app:layout_constraintTop_toTopOf="@+id/imageView16" />

            <TextView
                android:id="@+id/Update"
                android:layout_width="75dp"
                android:layout_height="22dp"
                android:layout_marginStart="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/updatebutton"
                android:text="Update"
                android:textAlignment="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_class_duration" />

            <TextView
                android:id="@+id/Delete"
                android:layout_width="79dp"
                android:layout_height="22dp"
                android:background="@drawable/deletebutton"
                android:text="Delete"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/Update"
                app:layout_constraintTop_toTopOf="@+id/Update" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
