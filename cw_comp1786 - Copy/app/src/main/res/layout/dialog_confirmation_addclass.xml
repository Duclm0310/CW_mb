<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Yoga Class Information"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/tv_class_session_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Class Title:" />

    <TextView
        android:id="@+id/tv_class_dayofweek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Day:" />

    <TextView
        android:id="@+id/tv_class_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time:" />

    <TextView
        android:id="@+id/tv_class_capacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capacity:" />
    <TextView
        android:id="@+id/tv_class_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duration:" />
    <TextView
        android:id="@+id/tv_class_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price:" />

    <TextView
        android:id="@+id/tv_class_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type:" />
    <TextView
        android:id="@+id/tv_class_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Description:" />

</LinearLayout>